<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Arbitrary.fs" />
    <Compile Include="ParquetFile.fs" />
    <Compile Include="Assert.fs" />
    <Compile Include="Test.Roundtrip.fs" />
    <Compile Include="Test.ParquetSerializer.fs" />
    <Compile Include="Test.Deserialize.DifferentSchema.fs" />
    <Compile Include="Test.Deserialize.TypeCompatibility.fs" />
    <Compile Include="Test.Bool.fs" />
    <Compile Include="Test.Int8.fs" />
    <Compile Include="Test.Int16.fs" />
    <Compile Include="Test.Int32.fs" />
    <Compile Include="Test.Int64.fs" />
    <Compile Include="Test.UInt8.fs" />
    <Compile Include="Test.UInt16.fs" />
    <Compile Include="Test.UInt32.fs" />
    <Compile Include="Test.UInt64.fs" />
    <Compile Include="Test.Float32.fs" />
    <Compile Include="Test.Float64.fs" />
    <Compile Include="Test.Decimal.fs" />
    <Compile Include="Test.Guid.fs" />
    <Compile Include="Test.Enum\Test.Enum.Int8.fs" />
    <Compile Include="Test.Enum\Test.Enum.Int16.fs" />
    <Compile Include="Test.Enum\Test.Enum.Int32.fs" />
    <Compile Include="Test.Enum\Test.Enum.Int64.fs" />
    <Compile Include="Test.Enum\Test.Enum.UInt8.fs" />
    <Compile Include="Test.Enum\Test.Enum.UInt16.fs" />
    <Compile Include="Test.Enum\Test.Enum.UInt32.fs" />
    <Compile Include="Test.Enum\Test.Enum.UInt64.fs" />
    <Compile Include="Test.TimeSpan.fs" />
    <Compile Include="Test.DateTime.fs" />
    <Compile Include="Test.DateTimeOffset.fs" />
    <Compile Include="Test.String.fs" />
    <Compile Include="Test.ByteArray.fs" />
    <Compile Include="Test.List\Test.List.fs" />
    <Compile Include="Test.List\Test.List.DateTime.fs" />
    <Compile Include="Test.Array1d.fs" />
    <Compile Include="Test.ResizeArray.fs" />
    <Compile Include="Test.Record.fs" />
    <Compile Include="Test.Record.Struct.fs" />
    <Compile Include="Test.Option\Test.Option.fs" />
    <Compile Include="Test.Option\Test.Option.DateTime.fs" />
    <Compile Include="Test.ValueOption.fs" />
    <Compile Include="Test.Nullable.fs" />
    <Compile Include="Test.Union.Enum.fs" />
    <Compile Include="Test.Union.SingleCase.fs" />
    <Compile Include="Test.Union.MultiCase.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" Version="3.3.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Unquote" Version="7.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Parquet.FSharp\Parquet.FSharp.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.301" />
  </ItemGroup>

</Project>
